{
  "name": "@mrt-identity/adapter-testkit",
  "version": "0.1.0",
  "description": "mrt-identity adapterları için ortak sözleşme testleri.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mrt-identity/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "keywords": [
    "authentication",
    "adapter",
    "testing",
    "contract-tests",
    "vitest"
  ],
  "author": "237mrt",
  "license": "MIT"
}