{
  "name": "@mrt-identity/adapter-testkit",
  "version": "0.1.0-alpha.1",
  "description": "Reusable adapter contract tests for mrt-identity adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@mrt-identity/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mrt-identity",
    "authentication",
    "adapter",
    "testing",
    "contract-tests",
    "vitest"
  ],
  "author": {
    "name": "237mrt",
    "url": "https://github.com/237mrt"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/237mrt/mrt-identity.git",
    "directory": "packages/adapter-testkit"
  },
  "homepage": "https://github.com/237mrt/mrt-identity/tree/main/packages/adapter-testkit#readme",
  "bugs": {
    "url": "https://github.com/237mrt/mrt-identity/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}