{
  "name": "@mrt-identity/adapter-memory",
  "version": "0.1.0-alpha.1",
  "description": "In-memory adapter for mrt-identity development and testing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@mrt-identity/core": "workspace:*"
  },
  "devDependencies": {
    "@mrt-identity/adapter-testkit": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mrt-identity",
    "authentication",
    "adapter",
    "memory",
    "in-memory",
    "testing"
  ],
  "author": {
    "name": "237mrt",
    "url": "https://github.com/237mrt"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/237mrt/mrt-identity.git",
    "directory": "packages/adapter-memory"
  },
  "homepage": "https://github.com/237mrt/mrt-identity/tree/main/packages/adapter-memory#readme",
  "bugs": {
    "url": "https://github.com/237mrt/mrt-identity/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}